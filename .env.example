# Neon connection string (Neon dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: set to "off" to skip creating the demo account test@bash.in / test1234
# DEMO_USER=off
