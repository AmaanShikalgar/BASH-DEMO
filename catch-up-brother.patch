+
+    const upload = (kind, file) => {
+        if (!file) return;
+        if (!DOC_MIME.includes(file.type)) return toast.error("Upload a JPG, PNG, WebP or PDF");
+        if (file.size > MAX_DOC_BYTES) return toast.error("File must be under 3 MB");
