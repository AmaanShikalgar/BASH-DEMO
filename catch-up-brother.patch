+        reader.onload = () =>
+            run(
+                () => api.post(`/dev/applications/${clubId}/documents`, { kind, file_name: file.name, data_url: reader.result }),
+                "Document uploaded",
+            );
+        reader.readAsDataURL(file);
+    };
