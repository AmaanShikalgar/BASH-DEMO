+
+    const load = useCallback(() => {
+        return api
+            .get(`/dev/applications/${clubId}`)
+            .then((r) => setD(r.data))
+            .catch((e) => toast.error(errText(e)));
+    }, [clubId]);
+
+    useEffect(() => {
+        load();
+    }, [load]);
+
+    const run = async (fn, okMsg) => {
+        setBusy(true);
+        try {
+            await fn();
+            toast.success(okMsg);
+            await load();
